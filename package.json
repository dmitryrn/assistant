{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "node --import tsx --test"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "@reduxjs/toolkit": "^2.9.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "expo": "^56.0.0",
    "expo-build-properties": "~56.0.19",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.11",
    "expo-intent-launcher": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-speech-recognition": "^56.0.0",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "llama.rn": "^0.12.4",
    "openai": "^6.35.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.1": true,
    "llama.rn@0.12.4": true,
    "unrs-resolver@1.11.1": true
  }
}
